<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>VbNet.LanguageServer</RootNamespace>
    <AssemblyName>VbNet.LanguageServer</AssemblyName>
    <LangVersion>latest</LangVersion>
    <OptionStrict>On</OptionStrict>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vbnet-ls</ToolCommandName>
    <PackageId>DNAKode.VbNet.Lsp</PackageId>
    <Authors>DNAKode</Authors>
    <Description>Roslyn-backed VB.NET language server with stdio and named pipe transport support.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/DNAKode/vbnet-lsp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/DNAKode/vbnet-lsp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>vbnet;visual-basic;lsp;language-server;roslyn</PackageTags>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageReadmeFile>NUGET_README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <Import Include="System" />
    <Import Include="System.IO" />
    <Import Include="System.Threading" />
    <Import Include="System.Threading.Tasks" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Collections.Concurrent" />
    <!-- Roslyn Workspace APIs for VB.NET language services -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Workspaces" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="4.12.0" />
    <!-- Roslyn Features for Completion, Hover, etc. -->
    <PackageReference Include="Microsoft.CodeAnalysis.Features" Version="4.12.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic.Features" Version="4.12.0" />

    <!-- MSBuild locator for finding MSBuild instance -->
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- Required for MSBuild.Locator 1.11+ to avoid MSBL001 + NU1903 warnings; keep PrivateAssets/ExcludeAssets to prevent runtime binding issues. -->
    <PackageReference Include="Microsoft.Build" Version="18.0.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Framework" Version="18.0.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Tasks.Core" Version="18.0.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" Version="18.0.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NET.StringTools" Version="18.0.2" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- Override vulnerable transitive 9.0.0 from MSBuild dependencies. -->
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.6" PrivateAssets="all" />

    <!-- Logging -->
    <PackageReference Include="Microsoft.Extensions.Logging" Version="9.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="NUGET_README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
