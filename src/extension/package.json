{
  "name": "vbnet-language-support",
  "publisher": "dnakode",
  "version": "0.1.10",
  "description": "First-class VB.NET language support for VS Code",
  "displayName": "VB.NET Language Support",
  "icon": "images/vbnet-icon.png",
  "author": "DNA Kode",
  "license": "MIT",
  "preview": true,
  "readme": "README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/DNAKode/vbnet-lsp"
  },
  "bugs": {
    "url": "https://github.com/DNAKode/vbnet-lsp/issues"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "VB.NET",
    "Visual Basic",
    "vb",
    ".NET",
    "dotnet",
    "language server"
  ],
  "engines": {
    "vscode": "^1.80.0"
  },
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "Requires a local or remote .NET SDK and project system; not supported in virtual workspaces (vscode.dev/github.dev)."
    },
    "untrustedWorkspaces": {
      "supported": "limited"
    }
  },
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onDebugInitialConfigurations",
    "onDebugResolve:vbnet",
    "onLanguage:vb",
    "workspaceContains:**/*.vbproj",
    "workspaceContains:**/*.sln",
    "workspaceContains:**/*.slnf",
    "workspaceContains:**/*.slnx"
  ],
  "extensionDependencies": [
    "ms-dotnettools.vscode-dotnet-runtime"
  ],
  "contributes": {
    "languages": [
      {
        "id": "vb",
        "aliases": [
          "Visual Basic",
          "VB.NET",
          "vb"
        ],
        "extensions": [
          ".vb"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "configuration": [
      {
        "title": "VB.NET Language Support",
        "properties": {
          "vbnet.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable/disable the VB.NET language server."
          },
          "vbnet.logLevel": {
            "type": "string",
            "enum": [
              "trace",
              "debug",
              "info",
              "warn",
              "error"
            ],
            "default": "info",
            "description": "Language server logging level."
          },
          "vbnet.server.path": {
            "type": "string",
            "default": "",
            "description": "Path to the VB.NET language server executable. Leave empty to use the bundled server."
          },
          "vbnet.server.backend": {
            "type": "string",
            "enum": [
              "vbnet",
              "roslyn"
            ],
            "default": "vbnet",
            "enumDescriptions": [
              "Use the bundled VB.NET language server",
              "Use the Roslyn language server (VB assemblies loaded via extension path)"
            ],
            "description": "Select which language server backend to use."
          },
          "vbnet.server.transportType": {
            "type": "string",
            "enum": [
              "auto",
              "namedPipe",
              "stdio"
            ],
            "default": "auto",
            "enumDescriptions": [
              "Automatically select the best transport (named pipes preferred, with stdio fallback)",
              "Use named pipes for communication",
              "Use standard input/output for communication"
            ],
            "description": "Transport type for language server communication."
          },
          "vbnet.trace.server": {
            "type": "string",
            "enum": [
              "off",
              "messages",
              "verbose"
            ],
            "default": "off",
            "description": "Traces the communication between VS Code and the VB.NET language server."
          },
          "vbnet.roslyn.server.path": {
            "type": "string",
            "default": "",
            "description": "Path to the Roslyn language server executable or DLL. Leave empty to use the bundled Roslyn server."
          },
          "vbnet.roslyn.server.extensionPath": {
            "type": "string",
            "default": "",
            "description": "Directory containing Roslyn VB extension assemblies (Microsoft.CodeAnalysis.VisualBasic*)."
          },
          "vbnet.diagnostics.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable real-time diagnostics (errors, warnings)."
          },
          "vbnet.diagnosticsMode": {
            "type": "string",
            "enum": [
              "openChange",
              "openSave",
              "saveOnly"
            ],
            "default": "openChange",
            "description": "When to compute diagnostics (open/change, open/save, or save-only)."
          },
          "vbnet.debounceMs": {
            "type": "number",
            "default": 300,
            "description": "Debounce delay in milliseconds for diagnostics updates."
          },
          "vbnet.completion.enable": {
            "type": "boolean",
            "default": true,
            "description": "Enable IntelliSense code completion."
          },
          "vbnet.enableFormatting": {
            "type": "boolean",
            "default": true,
            "description": "Enable document formatting."
          },
          "vbnet.enableCodeActions": {
            "type": "boolean",
            "default": true,
            "description": "Enable code actions and quick fixes."
          },
          "vbnet.semanticTokens": {
            "type": "boolean",
            "default": true,
            "description": "Enable semantic syntax highlighting."
          },
          "vbnet.inlayHints": {
            "type": "boolean",
            "default": false,
            "description": "Enable inline type and parameter hints."
          },
          "vbnet.debugger.path": {
            "type": "string",
            "default": "",
            "description": "Path to the netcoredbg executable. Leave empty to use the bundled debugger (or a PATH lookup when running from source)."
          },
          "vbnet.debugger.args": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Extra command line arguments passed to netcoredbg (for example, --engineLogging=/path/to/log.txt)."
          },
          "vbnet.debugger.workarounds.stackTraceNoInterfaceFallback": {
            "type": "boolean",
            "default": true,
            "description": "When netcoredbg returns stackTrace failure 0x80004002, return an empty stack instead of surfacing a hard adapter error."
          },
          "vbnet.workspace.solutionPath": {
            "type": "string",
            "default": "",
            "description": "Explicit path to a .sln file to load. Leave empty for auto-detection."
          },
          "vbnet.solutionPath": {
            "type": "string",
            "default": "",
            "description": "Legacy solution path setting. Prefer vbnet.workspace.solutionPath."
          },
          "vbnet.workspace.ignoreSolutionFiles": {
            "type": "boolean",
            "default": false,
            "description": "Ignore .sln files and load .vbproj files directly (solution-less mode)."
          },
          "vbnet.workspace.projectSearchPaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [],
            "description": "Directories to scan for .vbproj files (relative to workspace). Empty means workspace root."
          },
          "vbnet.workspace.excludePaths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "default": [
              "_external",
              "test-explore",
              "build",
              "node_modules",
              ".git",
              ".vscode"
            ],
            "description": "Directory names to exclude when scanning for .vbproj files."
          },
          "vbnet.workspace.projectFilesExcludePattern": {
            "type": "string",
            "default": "**/_external/**,**/test-explore/**,**/node_modules/**,**/.git/**,**/bower_components/**",
            "description": "Comma-separated glob patterns to exclude when searching for .sln/.vbproj files."
          },
          "vbnet.workspace.maxProjectResults": {
            "type": "number",
            "default": 250,
            "description": "Maximum number of project files to consider when no solution is present."
          },
          "vbnet.loadProjectsOnStart": {
            "type": "boolean",
            "default": true,
            "description": "Load projects during initialization."
          },
          "vbnet.maxProjectCount": {
            "type": "number",
            "default": 100,
            "description": "Maximum number of projects to load."
          },
          "vbnet.msbuildPath": {
            "type": "string",
            "default": "",
            "description": "Explicit MSBuild path override."
          },
          "vbnet.maxMemoryMB": {
            "type": "number",
            "default": 2048,
            "description": "Maximum memory usage (MB) before warning."
          }
        }
      }
    ],
    "commands": [
      {
        "command": "vbnet.restartServer",
        "title": "Restart VB.NET Language Server",
        "category": "VB.NET"
      },
      {
        "command": "vbnet.selectWorkspaceSolution",
        "title": "Select VB.NET Workspace Solution",
        "category": "VB.NET"
      },
      {
        "command": "vbnet.showLogs",
        "title": "Show VB.NET Logs",
        "category": "VB.NET"
      },
      {
        "command": "vbnet.toggleLspTrace",
        "title": "Toggle VB.NET LSP Trace",
        "category": "VB.NET"
      },
      {
        "command": "vbnet.restoreWorkspace",
        "title": "Restore VB.NET Workspace",
        "category": "VB.NET"
      },
      {
        "command": "vbnet.restoreProject",
        "title": "Restore VB.NET Project",
        "category": "VB.NET"
      },
      {
        "command": "vbnet.runTestsInContext",
        "title": "Run VB.NET Tests",
        "category": "VB.NET"
      },
      {
        "command": "vbnet.debugTestsInContext",
        "title": "Debug VB.NET Tests (Preview)",
        "category": "VB.NET"
      },
      {
        "command": "vbnet.reloadWorkspace",
        "title": "Reload VB.NET Workspace",
        "category": "VB.NET"
      },
      {
        "command": "vbnet.attachToProcess",
        "title": "Attach VB.NET Debugger to Process",
        "category": "VB.NET"
      },
      {
        "command": "vbnet.showOutputChannel",
        "title": "Show VB.NET Output",
        "category": "VB.NET"
      }
    ],
    "configurationDefaults": {
      "explorer.fileNesting.patterns": {
        "*.vb": "${capture}.Designer.vb,${capture}.g.vb,${capture}.g.i.vb,${capture}.generated.vb,${capture}.AssemblyInfo.vb,${capture}.My*.vb",
        "*.resx": "${capture}.Designer.vb",
        "*.vbproj": "${capture}.vbproj.user"
      }
    },
    "breakpoints": [
      {
        "language": "vb"
      }
    ],
    "debuggers": [
      {
        "type": "vbnet",
        "label": "VB.NET (netcoredbg)",
        "languages": [
          "vb"
        ],
        "configurationAttributes": {
          "launch": {
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the debug configuration."
              },
              "type": {
                "type": "string",
                "enum": [
                  "vbnet"
                ],
                "description": "Debugger type."
              },
              "request": {
                "type": "string",
                "enum": [
                  "launch"
                ],
                "description": "Debug request type."
              },
              "projectPath": {
                "type": "string",
                "description": "Path to the .vbproj to infer the debug program from."
              },
              "program": {
                "type": "string",
                "description": "Path to the compiled .NET assembly (.dll) to launch."
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Arguments passed to the program."
              },
              "cwd": {
                "type": "string",
                "description": "Working directory for the program."
              },
              "env": {
                "type": "object",
                "description": "Environment variables for the debuggee."
              },
              "console": {
                "type": "string",
                "enum": [
                  "internalConsole",
                  "integratedTerminal",
                  "externalTerminal"
                ],
                "description": "Console type to use for the debuggee."
              },
              "stopAtEntry": {
                "type": "boolean",
                "description": "Stop at program entry."
              },
              "justMyCode": {
                "type": "boolean",
                "description": "Step through user code only."
              },
              "enableStepFiltering": {
                "type": "boolean",
                "description": "Enable step filtering."
              }
            }
          },
          "attach": {
            "required": [
              "processId"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Name of the debug configuration."
              },
              "type": {
                "type": "string",
                "enum": [
                  "vbnet"
                ],
                "description": "Debugger type."
              },
              "request": {
                "type": "string",
                "enum": [
                  "attach"
                ],
                "description": "Debug request type."
              },
              "processId": {
                "type": "number",
                "description": "Process ID to attach to."
              }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "VB.NET: Launch (netcoredbg)",
            "description": "Launch a VB.NET program under netcoredbg.",
            "body": {
              "name": "VB.NET Launch",
              "type": "vbnet",
              "request": "launch",
              "program": "${workspaceFolder}/bin/Debug/net10.0/YourApp.dll",
              "args": [],
              "cwd": "${workspaceFolder}",
              "console": "internalConsole",
              "stopAtEntry": false
            }
          },
          {
            "label": "VB.NET: Launch (projectPath inference)",
            "description": "Launch using projectPath and let the extension infer the program.",
            "body": {
              "name": "VB.NET Launch (projectPath)",
              "type": "vbnet",
              "request": "launch",
              "projectPath": "${workspaceFolder}/YourProject.vbproj",
              "args": [],
              "cwd": "${workspaceFolder}",
              "console": "internalConsole",
              "stopAtEntry": false
            }
          },
          {
            "label": "VB.NET: Attach (netcoredbg)",
            "description": "Attach netcoredbg to a running .NET process.",
            "body": {
              "name": "VB.NET Attach",
              "type": "vbnet",
              "request": "attach",
              "processId": 0
            }
          }
        ],
        "initialConfigurations": [
          {
            "name": "VB.NET Launch",
            "type": "vbnet",
            "request": "launch",
            "program": "${workspaceFolder}/bin/Debug/net10.0/YourApp.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "internalConsole",
            "stopAtEntry": false
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "copy-changelog": "node scripts/copy-changelog.js",
    "package": "npm run copy-changelog && npm run compile && node esbuild.js --production",
    "bundle-server": "node scripts/copy-server.js --build",
    "bundle-roslyn": "node scripts/copy-roslyn-server.js",
    "bundle-roslyn:win32-x64": "node scripts/copy-roslyn-server.js --rid win-x64",
    "bundle-roslyn:linux-x64": "node scripts/copy-roslyn-server.js --rid linux-x64",
    "bundle-roslyn:darwin-x64": "node scripts/copy-roslyn-server.js --rid osx-x64",
    "bundle-roslyn:darwin-arm64": "node scripts/copy-roslyn-server.js --rid osx-arm64",
    "validate-roslyn": "node scripts/validate-roslyn-bundle.js",
    "bundle-debugger": "node scripts/copy-debugger.js",
    "bundle-debugger:win32-x64": "node scripts/copy-debugger.js --target win32-x64",
    "bundle-debugger:linux-x64": "node scripts/copy-debugger.js --target linux-x64",
    "bundle-debugger:darwin-x64": "node scripts/copy-debugger.js --target darwin-x64",
    "bundle-debugger:darwin-arm64": "node scripts/copy-debugger.js --target darwin-arm64",
    "package:vsix:win32-x64": "npm run bundle-server && npm run bundle-roslyn:win32-x64 && npm run bundle-debugger:win32-x64 && npm run package && vsce package --target win32-x64 --out vbnet-language-support-win32-x64.vsix",
    "package:vsix:linux-x64": "npm run bundle-server && npm run bundle-roslyn:linux-x64 && npm run bundle-debugger:linux-x64 && npm run package && vsce package --target linux-x64 --out vbnet-language-support-linux-x64.vsix",
    "package:vsix:darwin-x64": "npm run bundle-server && npm run bundle-roslyn:darwin-x64 && npm run bundle-debugger:darwin-x64 && npm run package && vsce package --target darwin-x64 --out vbnet-language-support-darwin-x64.vsix",
    "package:vsix:darwin-arm64": "npm run bundle-server && npm run bundle-roslyn:darwin-arm64 && npm run bundle-debugger:darwin-arm64 && npm run package && vsce package --target darwin-arm64 --out vbnet-language-support-darwin-arm64.vsix",
    "package:vsix": "npm run bundle-server && npm run bundle-roslyn && npm run bundle-debugger && npm run package && vsce package --out vbnet-language-support.vsix",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vscode/vsce": "^3.7.1",
    "esbuild": "^0.21.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.0"
  }
}
